# Copy to .env (gitignored) and fill in. Shared by agents/ and web-console/; host-specific values live only here.

# Ollama (native API; a trailing /v1 is stripped). Model is set in agents/root/src/main.rs.
OLLAMA_URL=http://<ollama-host>:11434
# canary-stt-server WebSocket and tts-server streaming endpoint, used by voice mode
STT_URL=ws://<stt-host>:8001/ws
TTS_URL=http://<tts-host>:8002/stream

# Web console, Inference box: "label=tailscale-hostname" pairs, comma separated
INFERENCE_HOSTS=windows=<windows-hostname>,macOS=<mac-hostname>
# Web console, credentials: Cloudflare Access-gated secrets Worker (OPENROUTER_API_KEY for the OpenRouter tab)
SECRETS_URL=https://<secrets-worker-host>
# Web console, Tunnels box: Cloudflare API token with read access to tunnels
CLOUDFLARE_API_TOKEN=
# Discord bot (root agent; token MAX_DISCORD_TOKEN comes from the secrets Worker). Optional:
# DISCORD_USERS=<comma-separated Discord user ids allowed to talk to Max; default: the bot application's owner>
# DISCORD_CHANNELS=<comma-separated channel ids Max is confined to; DMs and other channels are then ignored>
# DISCORD_MENTION_CHANNELS=<comma-separated shared channel ids where Max answers only when tagged @max>
# DISCORD_BOTS=<comma-separated bot user ids Max answers when they tag him; those turns run without tools>
# DISCORD=off   # disable the bot
# Chronos (time sub-agent). Optional:
# CHRONOS_CAL_INTERVAL=300            # seconds between calendar polls
# CHRONOS_CALENDAR=<calendar name>    # where new events go; default the first event calendar
# DISCORD_NOTIFY_CHANNEL=<channel id for sub-agent notifications; default the first of DISCORD_CHANNELS>
